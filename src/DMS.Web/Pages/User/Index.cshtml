@page
@model DMS.Web.Pages.User.IndexModel
@{
    ViewData["Title"] = "Profil";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <i class="bi bi-person-circle me-2"></i>Moj profil
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ime</dt>
                    <dd class="col-sm-8">@Model.FirstName</dd>

                    <dt class="col-sm-4">Prezime</dt>
                    <dd class="col-sm-8">@Model.LastName</dd>

                    <dt class="col-sm-4">Kompanija</dt>
                    <dd class="col-sm-8">@Model.CompanyName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Tip računa</dt>
                    <dd class="col-sm-8">
                        @if (Model.Role == "Firm")
                        {
                            <span class="badge bg-primary"><i class="bi bi-building me-1"></i>Računovodstveni servis</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-person me-1"></i>Klijent</span>
                        }
                    </dd>

                </dl>
            </div>
            <div class="card-footer text-end">
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Odjava
                    </button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-light">
                <i class="bi bi-key me-2 text-primary"></i>Promjena lozinke
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="ChangePassword">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="PasswordInput.CurrentPassword" class="form-label fw-semibold">Trenutna lozinka</label>
                        <input asp-for="PasswordInput.CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="PasswordInput.CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordInput.NewPassword" class="form-label fw-semibold">Nova lozinka</label>
                        <input asp-for="PasswordInput.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="PasswordInput.NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PasswordInput.ConfirmNewPassword" class="form-label fw-semibold">Potvrdite novu lozinku</label>
                        <input asp-for="PasswordInput.ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="PasswordInput.ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i>Sačuvaj lozinku
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
