@page
@model DMS.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-person-plus me-2 text-warning"></i>Registracija klijenta
                </h2>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.FirstName" class="form-label fw-semibold">Ime</label>
                            <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LastName" class="form-label fw-semibold">Prezime</label>
                            <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.CompanyName" class="form-label fw-semibold">Naziv kompanije</label>
                        <input asp-for="Input.CompanyName" class="form-control" autocomplete="organization" placeholder="Naziv vaše kompanije" />
                        <span asp-validation-for="Input.CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Email adresa</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Lozinka</label>
                        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Potvrdite lozinku</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100">
                        <i class="bi bi-person-check me-1"></i>Registruj se
                    </button>
                </form>

                <hr class="my-3" />
                <p class="text-center mb-0 text-muted small">
                    Već imate nalog? <a asp-page="/Account/Login">Prijavite se</a>
                </p>
            </div>
        </div>
    </div>
</div>
