@page
@{
    ViewData["Title"] = "Kontakti";
}

<section class="vf-contacts-hero rounded-4 p-4 p-md-5 mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-lg-8">
            <span class="badge text-bg-warning mb-3">V Finans Group</span>
            <h1 class="display-6 fw-bold mb-3">Kontakti i poslovna podrška</h1>
            <p class="lead text-secondary mb-0">
                Digitalno računovodstvo, poresko savjetovanje i administrativna podrška za moderno poslovanje.
                Kontaktirajte nas za ponudu ili brzu konsultaciju.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a href="https://vfinans.ba/" target="_blank" rel="noreferrer" class="btn btn-outline-dark btn-lg">
                <i class="bi bi-globe2 me-1"></i>Zvanična stranica
            </a>
        </div>
    </div>
</section>

<section class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">Zašto V Finans Group?</h2>
                <ul class="list-unstyled mb-0 vf-check-list">
                    <li><i class="bi bi-check-circle-fill text-warning me-2"></i>Digitalno računovodstvo prilagođeno modernom poslovanju</li>
                    <li><i class="bi bi-check-circle-fill text-warning me-2"></i>Finansijske usluge i savjeti za preduzetnike širom BiH</li>
                    <li><i class="bi bi-check-circle-fill text-warning me-2"></i>Brže dostavljanje dokumentacije bez papirologije i gužvi</li>
                    <li><i class="bi bi-check-circle-fill text-warning me-2"></i>Siguran pristup dokumentima i podacima kad god su vam potrebni</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">Kontaktirajte nas</h2>
                <p class="text-muted mb-3">Za upite, dokumentaciju i konsultacije dostupni smo putem telefona i e-maila.</p>
                <div class="vf-contact-line"><i class="bi bi-telephone text-warning me-2"></i>+387 61 785 086</div>
                <div class="vf-contact-line"><i class="bi bi-telephone text-warning me-2"></i>+387 61 204 765</div>
                <div class="vf-contact-line mb-3"><i class="bi bi-telephone text-warning me-2"></i>+387 60 337 4228</div>
                <div class="vf-contact-line"><i class="bi bi-envelope text-warning me-2"></i><a href="mailto:racunovodstvo@vfinans.ba">racunovodstvo@vfinans.ba</a></div>
                <div class="vf-contact-line"><i class="bi bi-envelope text-warning me-2"></i><a href="mailto:harunramic@vfinans.ba">harunramic@vfinans.ba</a></div>
                <div class="vf-contact-line"><i class="bi bi-envelope text-warning me-2"></i><a href="mailto:alminvaljevac@vfinans.ba">alminvaljevac@vfinans.ba</a></div>
            </div>
        </div>
    </div>
</section>

<section class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h3 class="h5 mb-3"><i class="bi bi-geo-alt text-warning me-2"></i>Lokacija 1</h3>
                <p class="mb-0 text-muted">Kakanjska bb, Topuzovo polje<br />71300 Visoko</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h3 class="h5 mb-3"><i class="bi bi-geo-alt text-warning me-2"></i>Lokacija 2</h3>
                <p class="mb-0 text-muted">Stupska BII<br />71210 Ilidža</p>
            </div>
        </div>
    </div>
</section>
