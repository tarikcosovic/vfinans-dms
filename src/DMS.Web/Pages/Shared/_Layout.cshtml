<!DOCTYPE html>
<html lang="bs-BA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - V Finans Group</title>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark vf-navbar shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/images/v-finans-logo.jpg" alt="V Finans Group" class="vf-logo" />
                    <span class="fw-bold">V Finans Group</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Prikaži navigaciju">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    @if (User.Identity?.IsAuthenticated is true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-md-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Index">
                                    <i class="bi bi-house-door me-1"></i>Početna
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Dms/Index">
                                    <i class="bi bi-files me-1"></i>Dokumenti
                                </a>
                            </li>
                            @if (User.IsInRole("Firm"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Admin/Clients">
                                        <i class="bi bi-people me-1"></i>Klijenti
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" href="https://vfinans.ba/kalkulator-obracun-plate/" target="_blank" rel="noreferrer">
                                    <i class="bi bi-calculator me-1"></i>Kalkulator
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true" title="Uskoro dostupno">
                                    <i class="bi bi-cash-coin me-1"></i>Finansije
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true" title="Uskoro dostupno">
                                    <i class="bi bi-bar-chart-line me-1"></i>Analitika
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Kontakti">
                                    <i class="bi bi-telephone me-1"></i>Kontakti
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/User/Index">
                                    <i class="bi bi-person-circle me-1"></i>Profil
                                </a>
                            </li>
                        </ul>
                    }

                    <ul class="navbar-nav ms-auto align-items-md-center">
                        @if (User.Identity?.IsAuthenticated is true)
                        {
                            var roleValue = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            var companyName = User.FindFirst("company_name")?.Value;
                            var roleLabel = roleValue switch
                            {
                                "Firm" => "Računovodstveni servis",
                                "Client" when !string.IsNullOrWhiteSpace(companyName) => $"Klijent · {companyName}",
                                "Client" => "Klijent",
                                _ => roleValue
                            };
                            <li class="nav-item">
                                <span class="nav-link text-warning small">
                                    <i class="bi bi-shield-check me-1"></i>@roleLabel
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="nav-link btn btn-link text-light">
                                        <i class="bi bi-box-arrow-right me-1"></i>Odjava
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Prijava
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i>Registracija
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i>@successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>@errMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="vf-footer pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="~/images/v-finans-logo.jpg" alt="V Finans Group" class="vf-logo vf-logo-footer" />
                        <div>
                            <h5 class="mb-1 text-white">V Finans Group</h5>
                            <p class="mb-0 text-light-emphasis small">Digitalno računovodstvo i finansijske usluge u BiH</p>
                        </div>
                    </div>
                    <p class="text-light-emphasis small mb-0">
                        Prepustite nam administraciju i brojke, a vi se fokusirajte na razvoj i širenje poslovanja.
                        Naša misija je da računovodstvo učinimo brzim, sigurnim i uvijek dostupnim.
                    </p>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h6 class="text-white">Kontakt</h6>
                    <ul class="list-unstyled small mb-0 text-light-emphasis">
                        <li><i class="bi bi-telephone me-2 text-warning"></i>+387 61 785 086</li>
                        <li><i class="bi bi-telephone me-2 text-warning"></i>+387 61 204 765</li>
                        <li><i class="bi bi-telephone me-2 text-warning"></i>+387 60 337 4228</li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h6 class="text-white">E-mail</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a class="vf-footer-link" href="mailto:harunramic@vfinans.ba">harunramic@vfinans.ba</a></li>
                        <li><a class="vf-footer-link" href="mailto:alminvaljevac@vfinans.ba">alminvaljevac@vfinans.ba</a></li>
                        <li><a class="vf-footer-link" href="mailto:racunovodstvo@vfinans.ba">racunovodstvo@vfinans.ba</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h6 class="text-white">Lokacije</h6>
                    <ul class="list-unstyled small mb-0 text-light-emphasis">
                        <li>Kakanjska bb,<br />Topuzovo polje,<br />71300 Visoko</li>
                        <li class="mt-2">Stupska BII,<br />Ilidža 71210</li>
                    </ul>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mt-4 pt-3 border-top border-secondary-subtle">
                <p class="mb-2 mb-md-0 text-light-emphasis small">&copy; @DateTime.Now.Year V Finans Group</p>
                <div class="d-flex align-items-center gap-3">
                    <a class="vf-footer-link small" href="https://vfinans.ba/" target="_blank" rel="noreferrer">vfinans.ba</a>
                    <a class="vf-footer-link small" href="https://www.instagram.com/vfinansgroup/" target="_blank" rel="noreferrer">
                        <i class="bi bi-instagram me-1"></i>Instagram
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <script>
        (function () {
            const token = document.querySelector('meta[name="csrf-token"]')?.content;
            if (token) {
                document.body.addEventListener('htmx:configRequest', function (e) {
                    e.detail.headers['X-CSRF-TOKEN'] = token;
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
