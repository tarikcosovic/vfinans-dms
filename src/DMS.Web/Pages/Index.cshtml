@page
@model IndexModel
@{
    ViewData["Title"] = "Početna";
}

<section class="vf-hero rounded-4 overflow-hidden mb-5">
    <div class="row g-0 align-items-center">
        <div class="col-lg-7 p-4 p-md-5">
            <span class="badge text-bg-warning mb-3">V-Finans Group</span>
            <h1 class="display-5 fw-bold mb-3">Digitalno računovodstvo i finansijske usluge za preduzetnike širom BiH</h1>
            <p class="lead text-secondary mb-4">
                Prepustite nam administraciju i brojke, a vi se fokusirajte na ono što najbolje radite — razvoj i širenje poslovanja.
                Naša misija je da računovodstvo učinimo brzim, sigurnim i uvijek dostupnim, bez nepotrebnih papira i gužvi.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (User.Identity?.IsAuthenticated is true)
                {
                    <a asp-page="/Dms/Index" class="btn btn-warning btn-lg">
                        <i class="bi bi-files me-1"></i>Otvori klijentski portal
                    </a>
                }
                else
                {
                    <a asp-page="/Account/Login" class="btn btn-warning btn-lg">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Prijava
                    </a>
                    <a asp-page="/Account/Register" class="btn btn-outline-dark btn-lg">
                        <i class="bi bi-person-plus me-1"></i>Registracija klijenta
                    </a>
                }
                <a href="https://vfinans.ba/" target="_blank" rel="noreferrer" class="btn btn-outline-secondary btn-lg">Saznaj više</a>
            </div>
        </div>
        <div class="col-lg-5 text-center p-4">
            <img src="~/images/v-finans-logo.jpg" alt="V Finans Group logo" class="img-fluid vf-home-logo" />
        </div>
    </div>
</section>

<section class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <i class="bi bi-cpu text-warning fs-2"></i>
                <h4 class="mt-3">Automatizacija i optimizacija</h4>
                <p class="text-muted mb-0">Kroz automatizaciju i optimizaciju procesa štedimo vaše vrijeme i novac, dok vi zadržavate potpunu kontrolu nad finansijama.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <i class="bi bi-graph-up-arrow text-warning fs-2"></i>
                <h4 class="mt-3">Uvid u realnom vremenu</h4>
                <p class="text-muted mb-0">Klijent ima trenutni uvid u stanje finansija, bilanse, promete po računima i PDV obaveze radi bržeg poslovnog odlučivanja.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
                <i class="bi bi-folder-check text-warning fs-2"></i>
                <h4 class="mt-3">Klijentski portal dokumenata</h4>
                <p class="text-muted mb-0">Siguran portal za razmjenu dokumentacije je dio usluge V Finans Group i omogućava bržu, pregledniju saradnju sa klijentima.</p>
            </div>
        </div>
    </div>
</section>

<section class="vf-home-cta card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5 d-md-flex justify-content-between align-items-center">
        <div>
            <h3 class="h4 mb-2">Trebate konsultacije ili želite započeti saradnju?</h3>
            <p class="text-muted mb-0">Sve kontakt informacije i detalji o saradnji nalaze se na stranici Kontakti.</p>
        </div>
        <a asp-page="/Kontakti" class="btn btn-warning mt-3 mt-md-0">
            <i class="bi bi-arrow-right-circle me-1"></i>Otvori Kontakti
        </a>
    </div>
</section>
