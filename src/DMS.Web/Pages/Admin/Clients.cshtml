@page
@model DMS.Web.Pages.Admin.ClientsModel
@{
    ViewData["Title"] = "Klijenti";
    var pendingCount = Model.Dashboard.PendingClients.Count;
    var activeCount = Model.Dashboard.ActiveClients.Count;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>Upravljanje klijentima</h2>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-warning-subtle">
            <div class="card-body">
                <div class="text-muted small mb-1">Čeka odobrenje</div>
                <div class="display-6 fw-semibold text-warning-emphasis">@pendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-success-subtle">
            <div class="card-body">
                <div class="text-muted small mb-1">Aktivni klijenti</div>
                <div class="display-6 fw-semibold text-success">@activeCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-warning-subtle mb-4">
    <div class="card-header bg-warning-subtle">
        <h3 class="h5 mb-0"><i class="bi bi-hourglass-split me-2"></i>Zahtjevi na čekanju</h3>
    </div>
    <div class="card-body p-0">
        @if (!Model.Dashboard.PendingClients.Any())
        {
            <div class="p-4 text-muted">Trenutno nema zahtjeva za odobrenje.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Klijent</th>
                            <th>Kompanija</th>
                            <th>Email</th>
                            <th>Promjena lozinke</th>
                            <th class="text-end">Akcija</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model.Dashboard.PendingClients)
                        {
                            <tr>
                                <td>@client.FirstName @client.LastName</td>
                                <td>@client.CompanyName</td>
                                <td>@client.Email</td>
                                <td style="min-width: 320px;">
                                    <form method="post" asp-page-handler="SetPassword" class="row g-2">
                                        <input type="hidden" name="userId" value="@client.UserId" />
                                        <div class="col-5">
                                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="Nova lozinka" minlength="8" required />
                                        </div>
                                        <div class="col-5">
                                            <input type="password" name="confirmPassword" class="form-control form-control-sm" placeholder="Potvrda" minlength="8" required />
                                        </div>
                                        <div class="col-2 d-grid">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Sačuvaj lozinku">
                                                <i class="bi bi-key"></i>
                                            </button>
                                        </div>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Approve" class="d-inline">
                                        <input type="hidden" name="userId" value="@client.UserId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check2-circle me-1"></i>Odobri
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h3 class="h5 mb-0"><i class="bi bi-person-check me-2"></i>Aktivni klijenti</h3>
    </div>
    <div class="card-body p-0">
        @if (!Model.Dashboard.ActiveClients.Any())
        {
            <div class="p-4 text-muted">Nema aktivnih klijenata.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Klijent</th>
                            <th>Kompanija</th>
                            <th>Email</th>
                            <th>Odobreno</th>
                            <th>Promjena lozinke</th>
                            <th class="text-end">Akcija</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model.Dashboard.ActiveClients)
                        {
                            <tr>
                                <td>@client.FirstName @client.LastName</td>
                                <td>@client.CompanyName</td>
                                <td>@client.Email</td>
                                <td class="text-nowrap text-muted small">
                                    @(client.ApprovedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                </td>
                                <td style="min-width: 320px;">
                                    <form method="post" asp-page-handler="SetPassword" class="row g-2">
                                        <input type="hidden" name="userId" value="@client.UserId" />
                                        <div class="col-5">
                                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="Nova lozinka" minlength="8" required />
                                        </div>
                                        <div class="col-5">
                                            <input type="password" name="confirmPassword" class="form-control form-control-sm" placeholder="Potvrda" minlength="8" required />
                                        </div>
                                        <div class="col-2 d-grid">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Sačuvaj lozinku">
                                                <i class="bi bi-key"></i>
                                            </button>
                                        </div>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Deactivate" class="d-inline">
                                        <input type="hidden" name="userId" value="@client.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i>Deaktiviraj
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
