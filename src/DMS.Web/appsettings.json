{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=<DB_HOST>;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>"
  },
  "R2": {
    "AccessKeyId": "<R2_ACCESS_KEY_ID>",
    "SecretAccessKey": "<R2_SECRET_ACCESS_KEY>",
    "BucketName": "<R2_BUCKET_NAME>",
    "ServiceUrl": "https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
  },
  "Seeding": {
    "FirmUsersInitialPassword": "<INITIAL_FIRM_PASSWORD>"
  }
}
